{
  "schema_version": 2,
  "api_base_url": "https://SEU-PROJETO.supabase.co/functions/v1/infra-monitor",
  "intervals": {
    "metrics": 3600,
    "ips": 3600,
    "processes": 3600,
    "poll": 60,
    "heartbeat": 300
  },
  "http_timeout_seconds": 15,
  "probe_timeout_ms": 1500,
  "catalog": [
    {
      "id": "frcaixa",
      "kind": "process",
      "process_name": "monitor.exe",
      "executable": "C:\\FrCaixaMonitor\\monitor.exe",
      "remote_control_enabled": true,
      "allowed_operations": [
        "start",
        "stop",
        "restart",
        "kill"
      ],
      "allow_force": true,
      "health_tcp_port": null
    },
    {
      "id": "rustdesk",
      "kind": "process",
      "executable": "C:\\Program Files\\RustDesk\\RustDesk.exe",
      "remote_control_enabled": true,
      "allowed_operations": [
        "start",
        "stop",
        "restart",
        "kill"
      ],
      "allow_force": true,
      "health_tcp_port": null
    },
    {
      "id": "system_cleanup",
      "kind": "process",
      "remote_control_enabled": true,
      "allowed_operations": [
        "start"
      ],
      "allow_force": false,
      "health_tcp_port": null
    },
    {
      "id": "powershell",
      "kind": "process",
      "allowed_operations": [
        "start"
      ],
      "allow_force": false
    },
    {
      "id": "cmd",
      "kind": "process",
      "allowed_operations": [
        "start"
      ],
      "allow_force": false
    }
  ]
}
